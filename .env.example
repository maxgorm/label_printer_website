# ============================
# Sentimo Environment Variables
# ============================

# Stripe
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_AUDIENCE_ID=

# Admin (for delay update endpoint)
ADMIN_API_KEY=your-secure-admin-key-here

# Shared secret sent by the Supabase Database Webhook to /api/shipment-notify
SHIPMENT_WEBHOOK_SECRET=your-long-random-secret-here

# Meta Pixel + Conversions API (see docs/META_TRACKING.md)
# The Pixel ID is also set as META_PIXEL_ID in public/assets/js/tracking.js
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: Graph API version (default v23.0) and Events Manager test code (remove for production)
META_API_VERSION=
META_TEST_EVENT_CODE=
